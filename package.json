{
  "name": "happy-platform-skills",
  "version": "2.3.0",
  "description": "Reusable development patterns and automation recipes for enterprise platforms - works with Claude, ChatGPT, and any agentic AI system",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./skills/*": "./skills/*",
    "./loader": "./src/loader.js"
  },
  "bin": {
    "hps": "src/cli.js",
    "sn-skills": "src/cli.js"
  },
  "scripts": {
    "validate": "node src/validator.js",
    "list": "node src/cli.js list",
    "search": "node src/cli.js search",
    "publish:dry-run": "npm publish --dry-run",
    "verify:package": "node scripts/verify-package.mjs",
    "contract:refresh": "node scripts/refresh-mcp-tool-contract.mjs",
    "contract:check": "node scripts/refresh-mcp-tool-contract.mjs --check",
    "contract:nl-check": "node scripts/check-natural-language-contract.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "platform-skills",
    "ai-skills",
    "claude",
    "chatgpt",
    "llm",
    "agentic-ai",
    "itsm",
    "itil",
    "incident-management",
    "change-management",
    "cmdb",
    "automation",
    "enterprise-platform",
    "happy-technologies",
    "skills-sh"
  ],
  "author": "Happy Technologies LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Happy-Technologies-LLC/happy-platform-skills.git"
  },
  "homepage": "https://github.com/Happy-Technologies-LLC/happy-platform-skills#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Happy-Technologies-LLC"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/nickzitzer"
    }
  ],
  "bugs": {
    "url": "https://github.com/Happy-Technologies-LLC/happy-platform-skills/issues"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "js-yaml": "3.15.0"
  },
  "devDependencies": {
    "jest": "^30.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "src/**/*",
    "contracts/**/*",
    "scripts/verify-package.mjs",
    "scripts/refresh-mcp-tool-contract.mjs",
    "scripts/check-natural-language-contract.mjs",
    "skills/**/*",
    "templates/**/*",
    "docs/**/*",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "README.md"
  ]
}
